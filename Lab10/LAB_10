#include <LiquidCrystal.h>

LiquidCrystal lcd(36, 37, 26, 27, 28, 29);

const int a = 2, b = 3, c = 4, d = 5, e = 6, f = 7, g = 8;
const int gnd1 = 9, gnd2 = 10, gnd3 = 11, gnd4 = 12;

int dig1 = 0;
int dig2 = 0;
int dig3 = 0;
int dig4 = 0;

unsigned long sonZaman = 0;

void setup() {
  pinMode(a, OUTPUT); 
  pinMode(b, OUTPUT); 
  pinMode(c, OUTPUT);
  pinMode(d, OUTPUT); 
  pinMode(e, OUTPUT); 
  pinMode(f, OUTPUT); 
  pinMode(g, OUTPUT);
  
  pinMode(gnd1, OUTPUT); 
  pinMode(gnd2, OUTPUT); 
  pinMode(gnd3, OUTPUT); 
  pinMode(gnd4, OUTPUT);

  digitalWrite(gnd1, LOW); 
  digitalWrite(gnd2, LOW);
  digitalWrite(gnd3, LOW); 
  digitalWrite(gnd4, LOW);

  lcd.begin(16, 2);
  lcd.print("Counter:");
}

void loop() {
  if (millis() - sonZaman >= 1000) { 
    sonZaman = millis();
    incrementCounter();
    updateLCD();
  }

  sayiyiGoster(dig1);
  digitalWrite(gnd1, HIGH);
  delay(4);
  digitalWrite(gnd1, LOW);

  sayiyiGoster(dig2);
  digitalWrite(gnd2, HIGH);
  delay(4);
  digitalWrite(gnd2, LOW);

  sayiyiGoster(dig3);
  digitalWrite(gnd3, HIGH);
  delay(4);
  digitalWrite(gnd3, LOW);

  sayiyiGoster(dig4);
  digitalWrite(gnd4, HIGH);
  delay(4);
  digitalWrite(gnd4, LOW);
}

void incrementCounter() {
  dig1++;
  
  if (dig1 >= 10) {
    dig1 = 0;
    dig2++;
  }
  if (dig2 >= 10) {
    dig2 = 0;
    dig3++;
  }
  if (dig3 >= 10) {
    dig3 = 0;
    dig4++;
  }
  if (dig4 >= 10) {
    dig4 = 0;
  }
}

void updateLCD() {
  lcd.setCursor(0, 0);
  lcd.print("Counter: ");
  lcd.print(dig4);
  lcd.print(dig3);
  lcd.print(dig2);
  lcd.print(dig1);
  lcd.print(" ");
}

void sayiyiGoster(int rakam) {
  digitalWrite(a, LOW); 
  digitalWrite(b, LOW); 
  digitalWrite(c, LOW);
  digitalWrite(d, LOW); 
  digitalWrite(e, LOW); 
  digitalWrite(f, LOW); 
  digitalWrite(g, LOW);

  switch (rakam) {
    case 0: 
      digitalWrite(a, HIGH); digitalWrite(b, HIGH); digitalWrite(c, HIGH);
      digitalWrite(d, HIGH); digitalWrite(e, HIGH); digitalWrite(f, HIGH);
      break;
    case 1: 
      digitalWrite(b, HIGH); digitalWrite(c, HIGH); 
      break;
    case 2: 
      digitalWrite(a, HIGH); digitalWrite(b, HIGH); digitalWrite(d, HIGH);
      digitalWrite(e, HIGH); digitalWrite(g, HIGH); 
      break;
    case 3: 
      digitalWrite(a, HIGH); digitalWrite(b, HIGH); digitalWrite(c, HIGH);
      digitalWrite(d, HIGH); digitalWrite(g, HIGH); 
      break;
    case 4: 
      digitalWrite(b, HIGH); digitalWrite(c, HIGH); digitalWrite(f, HIGH);
      digitalWrite(g, HIGH); 
      break;
    case 5: 
      digitalWrite(a, HIGH); digitalWrite(c, HIGH); digitalWrite(d, HIGH);
      digitalWrite(f, HIGH); digitalWrite(g, HIGH); 
      break;
    case 6: 
      digitalWrite(a, HIGH); digitalWrite(c, HIGH); digitalWrite(d, HIGH);
      digitalWrite(e, HIGH); digitalWrite(f, HIGH); digitalWrite(g, HIGH); 
      break;
    case 7: 
      digitalWrite(a, HIGH); digitalWrite(b, HIGH); digitalWrite(c, HIGH); 
      break;
    case 8: 
      digitalWrite(a, HIGH); digitalWrite(b, HIGH); digitalWrite(c, HIGH);
      digitalWrite(d, HIGH); digitalWrite(e, HIGH); digitalWrite(f, HIGH);
      digitalWrite(g, HIGH); 
      break;
    case 9: 
      digitalWrite(a, HIGH); digitalWrite(b, HIGH); digitalWrite(c, HIGH);
      digitalWrite(d, HIGH); digitalWrite(f, HIGH); digitalWrite(g, HIGH); 
      break;
  }
}
